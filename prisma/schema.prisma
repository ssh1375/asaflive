// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Domain {
  id    String @id @default(uuid())
  name      String     @unique  // e.g. "asaflive.ir"
  roles Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Role {
  id    String @id @default(uuid())
  name        String       
  permissions Permission[] // implicit M:N
  users   User[]

  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id])
  
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, domainId])
}


model Permission {
  id    String @id @default(uuid())
  name  String @unique  // e.g. "article:create"
  description  String?
  roles Role[] // implicit M:N

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model User {
  id    String @id @default(uuid())
  email           String?   @unique
  phone           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  isActive        Boolean   @default(true)
  isPhoneVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  roles           Role[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}




model Meeting {
  id              String   @id @default(uuid())
  name            String
  emptyTimeout    Int
  maxParticipants Int
  sessionExpiry   Int
  metadata        Json

  egressdata      Json?

  // فیلدهای زمان
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ارتباط با کاربرانی که به جلسه دعوت شده‌اند
  participants    MeetingParticipant[]
}


model MeetingParticipant {
  id          String   @id @default(uuid())
  
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  
  // 1. Registered Site User (Optional)
  // If the person is logged in, this field will be populated
  userId      String?  
  // user     User?    @relation(fields: [userId], references: [id]) 
  
  // 2. Guest Information (Mandatory or optional depending on your logic)
  // The name displayed in the meeting (whether a registered user or a guest)
  displayName String   
  
  // 3. Invitation Token (Crucial for guests)
  // For anonymous guests, you generate a unique link containing this token
  // Example: mydomain.com/join?token=abc-123
  inviteToken String?  @unique 
  
  phone       String   //phone number
  role        String   @default("GUEST") // HOST, GUEST
  isInvited   Boolean  @default(true)
  joinedAt    DateTime? 

  createdAt   DateTime @default(now())
  
  // Note: When userId can be null, using a composite unique constraint is tricky.
  // We removed the database-level unique constraint here. You should handle duplicate user prevention logic inside your NestJS code.
}


